{
    "name": "reporting-native-feature",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "libs/reporting/native-feature/src",
    "projectType": "library",
    "tags": [],
    "targets": {
        "lint": {
            "executor": "@nx/eslint:lint",
            "outputs": ["{options.outputFile}"],
            "options": {
                "lintFilePatterns": [
                    "libs/reporting/native-feature/**/*.{ts,tsx,js,jsx}"
                ]
            }
        },
        "test": {
            "executor": "@nx/jest:jest",
            "outputs": [
                "{workspaceRoot}/coverage/libs/reporting/native-feature"
            ],
            "options": {
                "jestConfig": "libs/reporting/native-feature/jest.config.ts",
                "passWithNoTests": true
            }
        }
    }
}
