{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "allowJs": true,
        "esModuleInterop": true,
        "incremental": true,
        "isolatedModules": true,
        "jsx": "preserve",
        "module": "esnext",
        "noEmit": true,
        "plugins": [{ "name": "next" }],
        "strict": true,
        "types": ["node", "react", "react-dom"]
    },
    "include": [
        "next-env.d.ts",
        ".next/types/**/*.ts",
        "src/**/*.ts",
        "src/**/*.tsx"
    ],
    "exclude": ["node_modules", "jest.config.ts", "**/*.spec.ts", "**/*.spec.tsx"]
}
