require_relative '../node_modules/react-native/scripts/react_native_pods'
require_relative '../node_modules/@react-native-community/cli-platform-ios/native_modules'
require_relative '../node_modules/@nrwl/react-native/nx_post_install'

platform :ios, '11.0'

target 'MobileUi' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # to enable hermes on iOS, change `false` to `true` and then install pods
    :hermes_enabled => false
  )

  # Enables Flipper.
  #
  # Note that if you have use_frameworks! enabled, Flipper will not work and
  # you should disable the next line.
  # Flipper 0.99 used by RN 0.67 is not compatible with newer Xcode toolchains.
  # Disable it for local development/simulator builds.
  # use_flipper!()

  pod 'RNAWSCognito', :path => '../node_modules/amazon-cognito-identity-js'

  post_install do |installer|
    react_native_post_install(installer)
    __apply_Xcode_12_5_M1_post_install_workaround(installer)
    nx_post_install(installer)

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'gnu++14'
        defs = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
        defs << '_LIBCPP_ENABLE_CXX17_REMOVED_UNARY_BINARY_FUNCTION'

        # RN 0.67 Yoga emits bitwise-on-bool warnings with newer Xcode/clang.
        # Treat this warning as non-error so legacy toolchain can still build.
        if target.name == 'Yoga'
          cpp_flags = config.build_settings['OTHER_CPLUSPLUSFLAGS'] ||= ['$(inherited)']
          cpp_flags << '-Wno-error=bitwise-instead-of-logical'
        end
      end
    end
  end
end
