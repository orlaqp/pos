    "scripts": {
        "start": "cd apps/mobile-ui && node ../../node_modules/@react-native-community/cli/build/bin.js start",
        "build": "nx build",
        "test": "nx test",
    "ios": "node tools/run-ios.js",
    "ios-new": "IOS_SIMULATOR=\"iPad (9th generation)\" node tools/run-ios.js",
        "list-simulators": "xcrun simctl list --json devices available",
        "new-feature": "hygen native feature",
        "new-data-access": "hygen data-access new",
        "update-models": "cp -R apps/mobile-ui/src/models libs/shared/models/src",
        "update-graphql": "cp -R apps/mobile-ui/src/graphql libs/shared/api/src",
        "update-api": "cp -R apps/mobile-ui/src/API.ts libs/shared/api/src",
        "update-codegen": "yarn update-models && yarn update-graphql && yarn update-api",
        "update-amplify": "cd apps/mobile-ui && amplify push && amplify codegen models && cd ../.. && yarn update-codegen",
        "update-amplify-local": "cd apps/mobile-ui && amplify codegen statements && amplify codegen types && amplify codegen models && cd ../.. && yarn update-codegen"
    },
