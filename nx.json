{
    "implicitDependencies": {
        "package.json": {
            "dependencies": "*",
            "devDependencies": "*"
        },
        ".eslintrc.json": "*"
    },
    "defaultProject": "mobile-ui",
    "generators": {
        "@nrwl/react": {
            "application": {
                "babel": true
            }
        }
    },
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "targetDefaults": {
        "build": {
            "dependsOn": ["^build"],
            "cache": true
        },
        "lint": {
            "cache": true
        },
        "test": {
            "cache": true
        },
        "e2e": {
            "cache": true
        }
    },
    "useInferencePlugins": false,
    "defaultBase": "main"
}
